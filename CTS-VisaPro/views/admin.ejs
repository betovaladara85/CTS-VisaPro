      <span id="templateModalTitle"><i class="fas fa-edit"></i> Editar Plantilla</span>
      <button class="close" onclick="closeTemplateModal()">&times;</button>
    </div>
    <div class="modal-body" id="templateModalBody"></div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<script>
  const SECTIONES_DS160 = [
    { id: 1, title: 'Datos Personales', desc: 'Nombre completo, fecha y lugar de nacimiento, género, estado civil, nacionalidad.' },
    { id: 2, title: 'Información del Pasaporte', desc: 'Número de pasaporte, país emisor, fecha de expedición y vencimiento.' },
    { id: 3, title: 'Información de Contacto', desc: 'Dirección actual, número de teléfono, email, redes sociales si aplica.' },
    { id: 4, title: 'Información del Viaje', desc: 'Propósito del viaje, fecha estimada, duración, alojamiento previsto.' },
    { id: 5, title: 'Información de Acompañantes', desc: 'Personas que viajan con el solicitante, si aplica.' },
    { id: 6, title: 'Historial de Viajes Previos', desc: 'Viajes anteriores a EE.UU., fechas, duración, motivo.' },
    { id: 7, title: 'Historial de Visas', desc: 'Visas americanas anteriores, número, fecha de emisión, si fueron renovadas.' },
    { id: 8, title: 'Información de Familiares', desc: 'Familiares en EE.UU.: padres, hijos, cónyuge. Datos de contacto y estatus migratorio.' },
    { id: 9, title: 'Información Laboral', desc: 'Empleo actual y previos (últimos 5 años): empresa, cargo, fechas, salario.' },
    { id: 10, title: 'Información Educativa', desc: 'Nivel de estudios, instituciones, fechas de asistencia, títulos obtenidos.' },
    { id: 11, title: 'Antecedentes de Seguridad', desc: 'Preguntas de seguridad: afiliaciones, problemas legales, enfermedades contagiosas.' },
    { id: 12, title: 'Carga de Documentos', desc: 'Foto tipo pasaporte, documentos de soporte, citas previas si aplica.' }
  ];

  let currentStep = 1;
  let currentPage = 'dashboard';

  async function api(url, opts = {}) {
    try {
      const res = await fetch(url, { 
        headers: { 'Content-Type': 'application/json' }, 
        credentials: 'include',
        ...opts 
      });
      if (res.redirected) { window.location.href = res.url; return null; }
      if (opts.download) return res;
      return res.json();
    } catch { return null; }
  }

  function toast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg; t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3000);
  }

  function timeAgo(iso) {
    const diff = Date.now() - new Date(iso).getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 1) return 'Ahora';
    if (mins < 60) return `Hace ${mins}m`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `Hace ${hrs}h`;
    const days = Math.floor(hrs / 24);
    if (days < 30) return `Hace ${days}d`;
    return new Date(iso).toLocaleDateString('es-MX');
  }

  function navigate(page) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.sidebar-nav a').forEach(a => a.classList.remove('active'));
    document.getElementById('page-' + page).classList.add('active');
    const link = document.querySelector(`.sidebar-nav a[data-page="${page}"]`);
    if (link) link.classList.add('active');
    currentPage = page;
    if (page === 'dashboard') renderDashboard();
    if (page === 'clientes') renderClientes();
    if (page === 'checklist') renderChecklist();
    if (page === 'mensajes') renderTemplates();
    if (page === 'exportar') renderExport();
  }
  document.querySelectorAll('.sidebar-nav a[data-page]').forEach(a => {
    a.addEventListener('click', () => navigate(a.dataset.page));
  });

  // ---- DASHBOARD ----
  async function renderDashboard() {
    const stats = await api('/api/admin/stats') || { total: 0, proceso: 0, aprobado: 0, rechazado: 0 };
    document.getElementById('statTotal').textContent = stats.total;
    document.getElementById('statProceso').textContent = stats.proceso;
    document.getElementById('statAprobado').textContent = stats.aprobado;
    document.getElementById('statRechazado').textContent = stats.rechazado;

    // Chart
    renderChart();

    const clients = await api('/api/admin/clientes') || [];
    const recent = clients.slice(-5).reverse();
    const container = document.getElementById('recentClients');
    if (!recent.length) {
      container.innerHTML = '<div class="empty-state"><i class="fas fa-inbox"></i><p>Aún no hay clientes registrados</p></div>';
      return;
    }
    let html = '<div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Pasaporte</th><th>Registro</th><th>Estado</th></tr></thead><tbody>';
    recent.forEach(c => {
      const tc = c.estado === 'aprobado' ? 'tag-aprobado' : c.estado === 'rechazado' ? 'tag-rechazado' : 'tag-proceso';
      const tl = c.estado === 'aprobado' ? 'Aprobado' : c.estado === 'rechazado' ? 'Rechazado' : 'En Proceso';
      html += `<tr onclick="verCliente(${c.id})"><td><strong>${c.nombre} ${c.apellido}</strong></td><td>${c.pasaporte}</td><td>${c.fecha_registro}</td><td><span class="tag ${tc}">${tl}</span></td></tr>`;
    });
    html += '</tbody></table></div>';
    container.innerHTML = html;
  }

  let chartInstance = null;
  async function renderChart() {
    const data = await api('/api/admin/stats/mensual') || [];
    const labels = data.map(d => d.mes);
    const values = data.map(d => d.total);
    const ctx = document.getElementById('chartMensual').getContext('2d');
    if (chartInstance) chartInstance.destroy();
    chartInstance = new Chart(ctx, {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          label: 'Clientes registrados',
          data: values,
          backgroundColor: '#1a56db',
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, ticks: { stepSize: 1 } },
          x: { grid: { display: false } }
        }
      }
    });
  }

  // ---- CLIENTES ----
  function setFilter(el) {
    document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    renderClientes();
  }

  async function renderClientes() {
    const q = document.getElementById('searchInput').value;
    const estado = document.querySelector('.filter-pill.active')?.dataset?.filter || 'all';
    const clients = await api(`/api/admin/clientes?q=${encodeURIComponent(q)}&estado=${encodeURIComponent(estado)}`) || [];
    const container = document.getElementById('clientesTableWrap');
    document.getElementById('clientCount').textContent = `${clients.length} cliente${clients.length !== 1 ? 's' : ''}`;
    if (!clients.length) {
      container.innerHTML = '<div class="empty-state"><i class="fas fa-search"></i><p>No se encontraron clientes</p></div>';
      return;
    }
    let html = '<table><thead><tr><th>Nombre</th><th>Pasaporte</th><th>Email</th><th>Teléfono</th><th>Registro</th><th>Actividad</th><th>Estado</th></tr></thead><tbody>';
    clients.forEach(c => {
      const tc = c.estado === 'aprobado' ? 'tag-aprobado' : c.estado === 'rechazado' ? 'tag-rechazado' : 'tag-proceso';
      const tl = c.estado === 'aprobado' ? 'Aprobado' : c.estado === 'rechazado' ? 'Rechazado' : 'En Proceso';
      const ultima = c.ultima_vista ? timeAgo(c.ultima_vista) : '-';
      html += `<tr onclick="verCliente(${c.id})"><td><strong>${c.nombre} ${c.apellido}</strong></td><td>${c.pasaporte}</td><td>${c.email_cliente || c.email}</td><td>${c.telefono}</td><td>${c.fecha_registro}</td><td style="font-size:12px;color:var(--cts-text-mid)">${ultima}</td><td><span class="tag ${tc}">${tl}</span></td></tr>`;
    });
    html += '</tbody></table>';
    container.innerHTML = html;
  }

  // ---- NUEVO CLIENTE ----
  function nextStep() {
    if (currentStep < 3) {
      document.querySelector(`.form-step[data-step="${currentStep}"]`).classList.add('hidden');
      document.querySelector(`.step[data-step="${currentStep}"]`).classList.remove('active');
      document.querySelector(`.step[data-step="${currentStep}"]`).classList.add('done');
      currentStep++;
      document.querySelector(`.form-step[data-step="${currentStep}"]`).classList.remove('hidden');
      document.querySelector(`.step[data-step="${currentStep}"]`).classList.add('active');
    }
  }
  function prevStep() {
    if (currentStep > 1) {
      document.querySelector(`.form-step[data-step="${currentStep}"]`).classList.add('hidden');
      document.querySelector(`.step[data-step="${currentStep}"]`).classList.remove('active');
      currentStep--;
      document.querySelector(`.form-step[data-step="${currentStep}"]`).classList.remove('hidden');
      document.querySelector(`.step[data-step="${currentStep}"]`).classList.add('active');
      document.querySelector(`.step[data-step="${currentStep}"]`).classList.remove('done');
    }
  }
  async function guardarCliente() {
    const required = ['fNombre','fApellido','fFechaNac','fPasaporte','fFechaVen','fEmail','fTelefono'];
    for (const id of required) {
      if (!document.getElementById(id).value.trim()) { toast('Completa todos los campos obligatorios (*)'); return; }
    }
    const data = {
      nombre: document.getElementById('fNombre').value.trim(),
      apellido: document.getElementById('fApellido').value.trim(),
      fecha_nacimiento: document.getElementById('fFechaNac').value,
      lugar_nacimiento: document.getElementById('fLugarNac').value.trim(),
      nacionalidad: document.getElementById('fNacionalidad').value.trim(),
      genero: document.getElementById('fGenero').value,
      estado_civil: document.getElementById('fEstadoCivil').value,
      ocupacion: document.getElementById('fOcupacion').value.trim(),
      pasaporte: document.getElementById('fPasaporte').value.trim(),
      pais_emision: document.getElementById('fPaisEmision').value.trim(),
      fecha_expedicion: document.getElementById('fFechaExp').value,
      fecha_vencimiento: document.getElementById('fFechaVen').value,
      email: document.getElementById('fEmail').value.trim(),
      telefono: document.getElementById('fTelefono').value.trim(),
      direccion: document.getElementById('fDireccion').value.trim(),
      ciudad: document.getElementById('fCiudad').value.trim(),
      estado_residencia: document.getElementById('fEstado').value.trim(),
      codigo_postal: document.getElementById('fCodigoPostal').value.trim(),
      proposito_viaje: document.getElementById('fProposito').value,
      fecha_viaje: document.getElementById('fFechaViaje').value,
      duracion: document.getElementById('fDuracion').value,
      alojamiento: document.getElementById('fAlojamiento').value.trim(),
      gastos_pagados_por: document.getElementById('fGastos').value,
      viaje_previo: document.getElementById('fViajePrev').value,
      visa_previa: document.getElementById('fVisaPrevia').value,
      negacion: document.getElementById('fNegacion').value,
      familiares_usa: document.getElementById('fFamiliares').value,
      notas: document.getElementById('fNotas').value.trim()
    };
    const result = await api('/api/admin/clientes', { method: 'POST', body: JSON.stringify(data) });
    if (!result) return;
    document.getElementById('clientForm').reset();
    currentStep = 1;
    document.querySelectorAll('.form-step').forEach(s => s.classList.add('hidden'));
    document.querySelector('.form-step[data-step="1"]').classList.remove('hidden');
    document.querySelectorAll('.step').forEach(s => s.classList.remove('active','done'));
    document.querySelector('.step[data-step="1"]').classList.add('active');
    const msg = result.temp_password ? `Cliente registrado. Contraseña temporal: ${result.temp_password}` : 'Cliente registrado';
    toast(msg);
    navigate('clientes');
  }

  // ---- MODAL CLIENTE ----
  async function verCliente(id) {
    const c = await api(`/api/admin/clientes/${id}`);
    if (!c) return;
    document.getElementById('modalTitle').textContent = `${c.nombre} ${c.apellido}`;
    const tc = c.estado === 'aprobado' ? 'tag-aprobado' : c.estado === 'rechazado' ? 'tag-rechazado' : 'tag-proceso';
    const tl = c.estado === 'aprobado' ? 'Aprobado' : c.estado === 'rechazado' ? 'Rechazado' : 'En Proceso';

    let html = `
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:8px">
        <span class="tag ${tc}" style="font-size:14px;padding:4px 14px">${tl}</span>
        <div class="inline-flex" style="flex-wrap:wrap">
          <button class="btn btn-sm btn-whatsapp" onclick="abrirWhatsApp(${c.id})"><i class="fab fa-whatsapp"></i> WhatsApp</button>
          <button class="btn btn-sm btn-outline" onclick="cambiarEstado(${c.id},'aprobado')"><i class="fas fa-check"></i> Aprobar</button>
          <button class="btn btn-sm btn-outline" onclick="cambiarEstado(${c.id},'rechazado')"><i class="fas fa-times"></i> Rechazar</button>
          <button class="btn btn-sm btn-danger" onclick="eliminarCliente(${c.id})"><i class="fas fa-trash"></i></button>
        </div>
      </div>
      ${c.login_creado ? `<div style="margin-bottom:12px;padding:10px 14px;background:var(--cts-beige);border-radius:8px;font-size:13px">Cliente con acceso: ${c.email_login} <button class="btn btn-sm btn-outline" onclick="resetPassword(${c.id})" style="float:right">Resetear contraseña</button></div>` : '<div style="margin-bottom:12px;padding:10px 14px;background:var(--cts-warning-light);border-radius:8px;font-size:13px">Este cliente no tiene acceso al sistema.</div>'}
      <div class="client-detail-grid">
        <div class="field"><div class="field-label">Nombre</div><div class="field-value">${c.nombre} ${c.apellido}</div></div>
        <div class="field"><div class="field-label">Fecha de Nacimiento</div><div class="field-value">${c.fecha_nacimiento || '-'}</div></div>
        <div class="field"><div class="field-label">Lugar de Nacimiento</div><div class="field-value">${c.lugar_nacimiento || '-'}</div></div>
        <div class="field"><div class="field-label">Nacionalidad</div><div class="field-value">${c.nacionalidad || '-'}</div></div>
        <div class="field"><div class="field-label">Género</div><div class="field-value">${c.genero || '-'}</div></div>
        <div class="field"><div class="field-label">Estado Civil</div><div class="field-value">${c.estado_civil || '-'}</div></div>
        <div class="field"><div class="field-label">Ocupación</div><div class="field-value">${c.ocupacion || '-'}</div></div>
        <div class="field"><div class="field-label">Pasaporte</div><div class="field-value">${c.pasaporte}</div></div>
        <div class="field"><div class="field-label">País Emisión</div><div class="field-value">${c.pais_emision || '-'}</div></div>
        <div class="field"><div class="field-label">Vencimiento Pasaporte</div><div class="field-value">${c.fecha_vencimiento || '-'}</div></div>
        <div class="field"><div class="field-label">Email</div><div class="field-value">${c.email}</div></div>
        <div class="field"><div class="field-label">Teléfono</div><div class="field-value">${c.telefono}</div></div>
        <div class="field"><div class="field-label">Dirección</div><div class="field-value">${c.direccion || '-'}</div></div>
        <div class="field"><div class="field-label">Ciudad / Estado</div><div class="field-value">${c.ciudad || ''}${c.estado ? ', ' + c.estado : ''}</div></div>
        <div class="field"><div class="field-label">Propósito Viaje</div><div class="field-value">${c.proposito_viaje || '-'}</div></div>
        <div class="field"><div class="field-label">Fecha Viaje</div><div class="field-value">${c.fecha_viaje || '-'}</div></div>
        <div class="field"><div class="field-label">Duración</div><div class="field-value">${c.duracion ? c.duracion + ' días' : '-'}</div></div>
        <div class="field"><div class="field-label">Gastos Pagados Por</div><div class="field-value">${c.gastos_pagados_por || '-'}</div></div>
        <div class="field"><div class="field-label">Viaje Previo USA</div><div class="field-value">${c.viaje_previo || '-'}</div></div>
        <div class="field"><div class="field-label">Visa Previa</div><div class="field-value">${c.visa_previa || '-'}</div></div>
        <div class="field"><div class="field-label">Negación Visa</div><div class="field-value">${c.negacion || '-'}</div></div>
        <div class="field"><div class="field-label">Familiares en USA</div><div class="field-value">${c.familiares_usa || '-'}</div></div>
      </div>
      ${c.notas ? `<div style="margin-top:12px"><div class="field-label">Notas</div><div class="field-value">${c.notas}</div></div>` : ''}
      <div style="margin-top:16px;border-top:1px solid var(--cts-beige-dark);padding-top:12px">
        <h4 style="margin-bottom:8px;font-size:14px"><i class="fas fa-file-upload"></i> Documentos</h4>
        <div id="docsList_${c.id}">${renderDocs(c)}</div>
        <div style="display:flex;gap:8px;margin-top:8px">
          <input type="file" id="docFile_${c.id}" style="flex:1;font-size:13px">
          <select id="docType_${c.id}" style="font-size:13px">
            <option value="documento">Documento</option>
            <option value="foto">Foto</option>
            <option value="pasaporte">Pasaporte</option>
            <option value="ds160">DS-160</option>
            <option value="cita">Cita</option>
          </select>
          <button class="btn btn-sm btn-primary" onclick="subirDocumento(${c.id})"><i class="fas fa-upload"></i></button>
        </div>
      </div>
      <div style="margin-top:12px;border-top:1px solid var(--cts-beige-dark);padding-top:12px">
        <h4 style="margin-bottom:8px;font-size:14px"><i class="fab fa-whatsapp" style="color:#25D366"></i> Historial WhatsApp</h4>
        <div id="waLog_${c.id}"><span style="font-size:12px;color:var(--cts-text-light)">Cargando...</span></div>
      </div>
    `;
    document.getElementById('modalBody').innerHTML = html;
    document.getElementById('clientModal').classList.add('open');
    cargarWALog(c.id);
  }

  function closeModal() { document.getElementById('clientModal').classList.remove('open'); }
  document.getElementById('clientModal').addEventListener('click', function(e) { if (e.target === this) closeModal(); });

  async function cambiarEstado(id, estado) {
    await api(`/api/admin/clientes/${id}/estado`, { method: 'PUT', body: JSON.stringify({ estado }) });
    closeModal();
    if (currentPage === 'clientes') renderClientes();
    if (currentPage === 'dashboard') renderDashboard();
    toast(`Cliente ${estado === 'aprobado' ? 'aprobado' : 'rechazado'}`);
  }

  async function eliminarCliente(id) {
    if (!confirm('¿Eliminar este cliente?')) return;
    await api(`/api/admin/clientes/${id}`, { method: 'DELETE' });
    closeModal();
    if (currentPage === 'clientes') renderClientes();
    if (currentPage === 'dashboard') renderDashboard();
    toast('Cliente eliminado');
  }

  async function resetPassword(id) {
    const result = await api(`/api/admin/clientes/${id}/reset-password`, { method: 'POST' });
    if (result) toast(`Nueva contraseña: ${result.temp_password}`);
  }

  function renderDocs(c) {
    const docs = c.documentos || [];
    if (!docs.length) return '<span style="font-size:12px;color:var(--cts-text-light)">Sin documentos</span>';
    return docs.map(d => `<div style="display:flex;align-items:center;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--cts-beige-dark);font-size:13px">
      <span><i class="fas fa-file"></i> ${d.nombre} <span style="color:var(--cts-text-light);font-size:11px">(${d.tipo})</span></span>
      <span style="display:flex;gap:4px">
        <a href="/uploads/${d.archivo}" target="_blank" class="btn btn-sm btn-outline" style="padding:2px 8px;font-size:11px"><i class="fas fa-eye"></i></a>
        <button class="btn btn-sm btn-danger" style="padding:2px 8px;font-size:11px" onclick="eliminarDocumento(${c.id},${d.id})"><i class="fas fa-trash"></i></button>
      </span>
    </div>`).join('');
  }

  async function subirDocumento(id) {
    const file = document.getElementById('docFile_' + id).files[0];
    if (!file) { toast('Selecciona un archivo'); return; }
    const tipo = document.getElementById('docType_' + id).value;
    const form = new FormData();
    form.append('file', file);
    form.append('tipo', tipo);
    const res = await fetch('/api/admin/clientes/' + id + '/documentos', { method: 'POST', body: form });
    if (!res.ok) { toast('Error al subir'); return; }
    document.getElementById('docFile_' + id).value = '';
    toast('Documento subido');
    verCliente(id);
  }

  async function eliminarDocumento(clientId, docId) {
    if (!confirm('¿Eliminar este documento?')) return;
    await fetch('/api/admin/clientes/' + clientId + '/documentos/' + docId, { method: 'DELETE' });
    toast('Documento eliminado');
    verCliente(clientId);
  }

  async function cargarWALog(id) {
    const logs = await api('/api/admin/whatsapp/logs/' + id) || [];
    const container = document.getElementById('waLog_' + id);
    if (!logs.length) { container.innerHTML = '<span style="font-size:12px;color:var(--cts-text-light)">Sin mensajes enviados</span>'; return; }
    container.innerHTML = logs.map(l => `<div style="display:flex;align-items:center;gap:8px;padding:4px 0;border-bottom:1px solid var(--cts-beige-dark);font-size:12px">
      <i class="fab fa-whatsapp" style="color:#25D366;font-size:14px"></i>
      <div style="flex:1"><div style="color:var(--cts-text-mid)">${l.message || '(sin texto)'}</div><div style="color:var(--cts-text-light);font-size:11px">${new Date(l.fecha).toLocaleString('es-MX')}</div></div>
    </div>`).join('');
  }

  // ---- WHATSAPP INTEGRATION ----
  let waClientId = null;

  async function abrirWhatsApp(id) {
    waClientId = id;
    const c = await api(`/api/admin/clientes/${id}`);
    if (!c) return;
    const templates = await api('/api/admin/templates') || [];
    const tel = c.telefono?.replace(/[^0-9]/g, '');
    let html = `
      <p style="font-size:14px;color:var(--cts-text-mid);margin-bottom:16px">
        Enviando a <strong>${c.nombre} ${c.apellido}</strong>
        ${tel ? `(${c.telefono})` : '<span style="color:var(--cts-danger)">Sin teléfono registrado</span>'}
      </p>
      <div style="margin-bottom:12px">
        <label>O escribe tu mensaje personalizado:</label>
        <textarea id="waCustomMsg" rows="4" placeholder="Escribe tu mensaje aquí..." oninput="checkWACustom()"></textarea>
      </div>
      <div style="margin-bottom:12px">
        <label>O elige una plantilla:</label>
        <div class="whatsapp-selector" id="waTemplates">
          ${templates.map(t => `
            <div class="whatsapp-option" onclick="selectWATemplate(${t.id}, this)">
              <strong>${t.title}</strong>
              <div style="font-size:11px;color:var(--cts-text-light);margin-top:2px">${t.text.substring(0, 60)}...</div>
            </div>
          `).join('')}
        </div>
      </div>
      <div style="display:flex;gap:8px">
        <button class="btn btn-outline w-full" onclick="closeWAModal()">Cancelar</button>
        <button class="btn btn-whatsapp w-full" id="waSendBtn" onclick="enviarWhatsApp()" ${!tel ? 'disabled' : ''}>
          <i class="fab fa-whatsapp"></i> Abrir WhatsApp
        </button>
      </div>
    `;
    document.getElementById('whatsappModalBody').innerHTML = html;
    document.getElementById('whatsappModal').classList.add('open');
  }

  let waSelectedTemplate = null;

  function selectWATemplate(id, el) {
    waSelectedTemplate = id;
    document.querySelectorAll('.whatsapp-option').forEach(o => o.classList.remove('selected'));
    el.classList.add('selected');
    document.getElementById('waCustomMsg').value = '';
  }

  function checkWACustom() {
    if (document.getElementById('waCustomMsg').value.trim()) {
      waSelectedTemplate = null;
      document.querySelectorAll('.whatsapp-option').forEach(o => o.classList.remove('selected'));
    }
  }

  async function enviarWhatsApp() {
    const c = await api(`/api/admin/clientes/${waClientId}`);
    if (!c) return;
    const tel = c.telefono?.replace(/[^0-9]/g, '');
    if (!tel) { toast('El cliente no tiene teléfono'); return; }

    let msg = document.getElementById('waCustomMsg').value.trim();
    if (!msg && waSelectedTemplate) {
      const templates = await api('/api/admin/templates') || [];
      const t = templates.find(x => x.id == waSelectedTemplate);
      if (t) msg = t.text;
    }
    if (!msg) { toast('Escribe un mensaje o selecciona una plantilla'); return; }

    msg = msg.replace(/\{\{nombre\}\}/g, `${c.nombre} ${c.apellido}`);
    await api('/api/admin/whatsapp/log', { method: 'POST', body: JSON.stringify({ client_id: waClientId, template_id: waSelectedTemplate, message: msg }) });
    const url = `https://wa.me/${tel}?text=${encodeURIComponent(msg)}`;
    window.open(url, '_blank');
    closeWAModal();
  }

  function closeWAModal() { document.getElementById('whatsappModal').classList.remove('open'); }
  document.getElementById('whatsappModal').addEventListener('click', function(e) { if (e.target === this) closeWAModal(); });

  // ---- CHECKLIST ----
  let checklistState = {};
  async function renderChecklist() {
    const list = await api('/api/admin/checklist') || [];
    checklistState = {};
    list.forEach(item => { checklistState[item.seccion_id] = item.completado; });
    const container = document.getElementById('checklistItems');
    let done = 0;
    let html = '';
    SECTIONES_DS160.forEach(s => {
      const checked = checklistState[s.id] || false;
      if (checked) done++;
      html += `<div class="checklist-item ${checked ? 'done' : ''}" onclick="toggleChecklist(${s.id})">
        <div class="cl-text"><div class="cl-title">Sección ${s.id}: ${s.title}</div><div class="cl-desc">${s.desc}</div></div>
        <i class="fas fa-${checked ? 'check-circle' : 'circle'}" style="color:${checked ? 'var(--cts-success)' : 'var(--cts-beige-dark)'};font-size:18px;margin-top:2px"></i>
      </div>`;
    });
    container.innerHTML = html;
    const pct = Math.round((done / SECTIONES_DS160.length) * 100);
    document.getElementById('checklistPercent').textContent = pct + '%';
    document.getElementById('checklistProgress').style.width = pct + '%';
  }
  async function toggleChecklist(id) {
    checklistState[id] = !checklistState[id];
    const list = Object.entries(checklistState).map(([seccion_id, completado]) => ({ seccion_id: parseInt(seccion_id), completado }));
    await api('/api/admin/checklist', { method: 'POST', body: JSON.stringify({ checklist: list }) });
    renderChecklist();
  }

  // ---- TEMPLATES (EDITABLES) ----
  async function renderTemplates() {
    const templates = await api('/api/admin/templates') || [];
    const container = document.getElementById('templatesContainer');
    if (!templates.length) {
      container.innerHTML = '<div class="empty-state"><i class="fas fa-comment-dots"></i><p>No hay plantillas. Crea una nueva.</p></div>';
      return;
    }
    let html = '';
    templates.forEach(t => {
      html += `<div class="template-card" id="tmpl-${t.id}">
        <div class="temp-title">
          <i class="fas ${t.icon || 'fa-comment'}" style="color:var(--cts-dark)"></i>
          <span class="tmpl-title">${t.title}</span>
          <div class="temp-actions">
            <button class="btn btn-sm btn-outline" onclick="editarPlantilla(${t.id})"><i class="fas fa-pen"></i></button>
            <button class="btn btn-sm btn-outline" onclick="copiarPlantillaTexto(${t.id})"><i class="fas fa-copy"></i></button>
            <button class="btn btn-sm btn-danger" onclick="eliminarPlantilla(${t.id})"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        <div class="temp-text tmpl-text">${t.text.replace(/\n/g, '<br>')}</div>
        <div style="font-size:11px;color:var(--cts-text-light);margin-top:6px">Variables: {{nombre}}, {{fecha}}, {{lugar}}</div>
      </div>`;
    });
    container.innerHTML = html;
  }

  function copiarPlantillaTexto(id) {
    const text = document.querySelector(`#tmpl-${id} .tmpl-text`).textContent;
    navigator.clipboard.writeText(text).then(() => toast('Texto copiado'));
  }

  function editarPlantilla(id) {
    const card = document.getElementById(`tmpl-${id}`);
    const title = card.querySelector('.tmpl-title').textContent;
    const text = card.querySelector('.tmpl-text').textContent;
    document.getElementById('templateModalTitle').textContent = 'Editar Plantilla';
    document.getElementById('templateModalBody').innerHTML = `
      <input type="hidden" id="editTmplId" value="${id}">
      <div class="form-group"><label>Título</label><input type="text" id="editTmplTitle" value="${title.replace(/"/g, '&quot;')}"></div>
      <div class="form-group"><label>Icono (clase FontAwesome)</label><input type="text" id="editTmplIcon" value="fa-comment" placeholder="fa-hand-wave, fa-bell, etc."></div>
      <div class="form-group"><label>Mensaje</label>
        <textarea id="editTmplText" rows="10" style="font-family:monospace;font-size:13px">${text}</textarea>
        <div style="font-size:11px;color:var(--cts-text-light);margin-top:4px">Usa {{nombre}}, {{fecha}}, {{lugar}} como variables</div>
      </div>
      <div style="display:flex;gap:8px;margin-top:8px">
        <button class="btn btn-outline" onclick="closeTemplateModal()">Cancelar</button>
        <button class="btn btn-primary" onclick="guardarPlantilla()"><i class="fas fa-save"></i> Guardar</button>
      </div>
    `;
    document.getElementById('templateModal').classList.add('open');
  }

  function nuevaPlantilla() {
    document.getElementById('templateModalTitle').textContent = 'Nueva Plantilla';
    document.getElementById('templateModalBody').innerHTML = `
      <input type="hidden" id="editTmplId" value="">
      <div class="form-group"><label>Título</label><input type="text" id="editTmplTitle" placeholder="Ej: Bienvenida"></div>
      <div class="form-group"><label>Icono</label><input type="text" id="editTmplIcon" value="fa-comment" placeholder="fa-hand-wave, fa-bell, etc."></div>
      <div class="form-group"><label>Mensaje</label>
        <textarea id="editTmplText" rows="10" style="font-family:monospace;font-size:13px" placeholder="Escribe tu plantilla aquí..."></textarea>
        <div style="font-size:11px;color:var(--cts-text-light);margin-top:4px">Usa {{nombre}}, {{fecha}}, {{lugar}} como variables</div>
      </div>
      <div style="display:flex;gap:8px;margin-top:8px">
        <button class="btn btn-outline" onclick="closeTemplateModal()">Cancelar</button>
        <button class="btn btn-success" onclick="guardarPlantilla()"><i class="fas fa-save"></i> Crear Plantilla</button>
      </div>
    `;
    document.getElementById('templateModal').classList.add('open');
  }

  async function guardarPlantilla() {
    const id = document.getElementById('editTmplId').value;
    const title = document.getElementById('editTmplTitle').value.trim();
    const icon = document.getElementById('editTmplIcon').value.trim() || 'fa-comment';
    const text = document.getElementById('editTmplText').value.trim();
    if (!title || !text) { toast('Completa título y mensaje'); return; }
    if (id) {
      await api(`/api/admin/templates/${id}`, { method: 'PUT', body: JSON.stringify({ title, icon, text }) });
      toast('Plantilla actualizada');
    } else {
      await api('/api/admin/templates', { method: 'POST', body: JSON.stringify({ title, icon, text }) });
      toast('Plantilla creada');
    }
    closeTemplateModal();
    renderTemplates();
  }

  async function eliminarPlantilla(id) {
    if (!confirm('¿Eliminar esta plantilla?')) return;
    await api(`/api/admin/templates/${id}`, { method: 'DELETE' });
    renderTemplates();
    toast('Plantilla eliminada');
  }

  function closeTemplateModal() { document.getElementById('templateModal').classList.remove('open'); }
  document.getElementById('templateModal').addEventListener('click', function(e) { if (e.target === this) closeTemplateModal(); });

  // ---- EXPORTAR ----
  async function renderExport() {
    const clients = await api('/api/admin/clientes') || [];
    document.getElementById('exportCount').textContent = clients.length;
    const container = document.getElementById('exportPreview');
    if (!clients.length) {
      container.innerHTML = '<div class="empty-state"><i class="fas fa-table"></i><p>No hay datos para exportar</p></div>';
      return;
    }
    const campos = ['nombre','apellido','email','telefono','pasaporte','fecha_nacimiento','nacionalidad','genero','estado_civil','ocupacion','pais_emision','fecha_vencimiento','proposito_viaje','fecha_viaje','duracion','estado','fecha_registro'];
    const labels = ['Nombre','Apellido','Email','Teléfono','Pasaporte','Fecha Nac.','Nacionalidad','Género','Estado Civil','Ocupación','País Emisión','Venc. Pasaporte','Propósito Viaje','Fecha Viaje','Duración','Estado','Registro'];
    let html = '<table><thead><tr>' + labels.map(l => `<th>${l}</th>`).join('') + '</tr></thead><tbody>';
    clients.slice(0,5).forEach(c => {
      html += '<tr>' + campos.map(campo => `<td>${c[campo] || '-'}</td>`).join('') + '</tr>';
    });
    if (clients.length > 5) {
      html += `<tr><td colspan="${campos.length}" style="text-align:center;color:var(--cts-text-light);font-style:italic">... y ${clients.length - 5} clientes más</td></tr>`;
    }
    html += '</tbody></table>';
    container.innerHTML = html;
  }

  function exportarExcel() { window.location.href = '/api/admin/exportar/excel'; }
  function exportarCSV() { window.location.href = '/api/admin/exportar/csv'; }

  // ---- INIT ----
  renderDashboard();
</script>
</body>
</html>
