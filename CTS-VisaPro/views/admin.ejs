<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CTS - Panel Administrativo</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;900&family=Inter:wght@300;400;500;600;700&display=swap');
    :root {
      --cts-dark: #2C1810;
      --cts-dark-light: #3D2A1E;
      --cts-gold: #C4A265;
      --cts-gold-light: #D4B87A;
      --cts-gold-pale: #EDE2CF;
      --cts-cream: #FAF8F5;
      --cts-beige: #F5F0EB;
      --cts-beige-dark: #E8E0D8;
      --cts-text: #2C1810;
      --cts-text-mid: #6B5B4F;
      --cts-text-light: #9A8B7E;
      --cts-white: #FFFFFF;
      --cts-success: #2D7D46;
      --cts-success-light: #E8F5ED;
      --cts-warning: #8B7D3C;
      --cts-warning-light: #F5F0E0;
      --cts-danger: #8B2500;
      --cts-danger-light: #FDEEE8;
      --radius: 6px;
      --radius-sm: 4px;
      --shadow: 0 1px 3px rgba(44,24,16,0.04);
      --shadow-md: 0 2px 8px rgba(44,24,16,0.06);
      --shadow-lg: 0 8px 24px rgba(44,24,16,0.08);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--cts-cream);
      color: var(--cts-text);
      min-height: 100vh;
      font-size: 14px;
    }
    h1, h2, h3, h4 { font-family: 'Playfair Display', serif; font-weight: 600; color: var(--cts-dark); }

    /* ── Sidebar ── */
    .sidebar {
      position: fixed; left: 0; top: 0; bottom: 0; width: 240px;
      background: var(--cts-dark);
      display: flex; flex-direction: column; z-index: 100;
    }
    .sidebar::after {
      content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 3px;
      background: var(--cts-gold);
    }
    .sidebar-brand {
      padding: 28px 20px 24px;
      display: flex; align-items: center; gap: 12px;
      border-bottom: 1px solid rgba(196,162,101,0.12);
    }
    .sidebar-brand .brand-icon {
      width: 34px; height: 34px; flex-shrink: 0;
      background: var(--cts-gold);
      border-radius: 4px; display: flex; align-items: center; justify-content: center;
      font-family: 'Playfair Display', serif; font-size: 14px; font-weight: 700;
      color: var(--cts-dark); letter-spacing: 0.5px;
    }
    .sidebar-brand .brand-text { display: flex; flex-direction: column; gap: 1px; }
    .sidebar-brand .brand-name {
      font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 600;
      color: var(--cts-gold); letter-spacing: 1px;
    }
    .sidebar-brand .brand-sub {
      font-size: 8px; color: rgba(196,162,101,0.45); font-weight: 500;
      letter-spacing: 2px; text-transform: uppercase;
    }
    .sidebar-nav { flex: 1; padding: 16px 10px; display: flex; flex-direction: column; gap: 2px; }
    .sidebar-nav a {
      display: flex; align-items: center; gap: 10px; padding: 10px 14px;
      border-radius: var(--radius-sm); color: rgba(255,255,255,0.45); text-decoration: none;
      font-size: 13px; font-weight: 500; transition: all 0.2s; cursor: pointer;
    }
    .sidebar-nav a:hover { background: rgba(196,162,101,0.08); color: rgba(255,255,255,0.8); }
    .sidebar-nav a.active { background: rgba(196,162,101,0.12); color: var(--cts-gold); font-weight: 600; }
    .sidebar-nav a i { width: 18px; text-align: center; font-size: 14px; opacity: 0.8; }
    .sidebar-footer {
      padding: 14px 20px; border-top: 1px solid rgba(196,162,101,0.1);
      font-size: 9px; color: rgba(255,255,255,0.2); text-align: center;
      letter-spacing: 1.5px; text-transform: uppercase;
    }

    /* ── Main ── */
    .main { margin-left: 240px; padding: 32px 40px; max-width: 1300px; position: relative; z-index: 1; }
    .page-header { margin-bottom: 28px; padding-bottom: 16px; border-bottom: 1px solid var(--cts-beige-dark); }
    .page-header h1 { font-size: 26px; font-weight: 700; color: var(--cts-dark); letter-spacing: -0.3px; }
    .page-header p { font-size: 13px; color: var(--cts-text-light); margin-top: 4px; }
    .page { display: none; }
    .page.active { display: block; animation: fadeIn 0.25s ease; }

    /* ── Stats ── */
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 28px; }
    .stat-card {
      background: var(--cts-white); border-radius: var(--radius); padding: 20px;
      box-shadow: var(--shadow); border: 1px solid var(--cts-beige-dark);
      position: relative; overflow: hidden;
    }
    .stat-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    }
    .stat-card:nth-child(1)::before { background: var(--cts-dark); }
    .stat-card:nth-child(2)::before { background: var(--cts-gold); }
    .stat-card:nth-child(3)::before { background: var(--cts-success); }
    .stat-card:nth-child(4)::before { background: var(--cts-danger); }
    .stat-card .stat-label { font-size: 10px; color: var(--cts-text-light); font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
    .stat-card .stat-value { font-size: 28px; font-weight: 700; margin-top: 6px; color: var(--cts-dark); }
    .stat-card .stat-icon { float: right; font-size: 22px; opacity: 0.08; color: var(--cts-dark); }

    /* ── Buttons ── */
    .btn {
      display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px;
      border-radius: var(--radius-sm); border: none; font-size: 13px; font-weight: 600;
      cursor: pointer; transition: all 0.2s; text-decoration: none;
      letter-spacing: 0.3px;
    }
    .btn-primary { background: var(--cts-dark); color: var(--cts-gold); }
    .btn-primary:hover { background: var(--cts-dark-light); }
    .btn-success { background: var(--cts-success); color: white; }
    .btn-outline { background: var(--cts-white); color: var(--cts-text-mid); border: 1px solid var(--cts-beige-dark); }
    .btn-outline:hover { background: var(--cts-beige); border-color: var(--cts-gold); }
    .btn-danger { background: var(--cts-danger); color: white; }
    .btn-sm { padding: 4px 10px; font-size: 11px; }
    .btn-whatsapp { background: #25D366; color: white; }
    .btn-whatsapp:hover { background: #1da851; }

    /* ── Cards ── */
    .card {
      background: var(--cts-white); border-radius: var(--radius); box-shadow: var(--shadow);
      border: 1px solid var(--cts-beige-dark); overflow: hidden;
    }
    .card + .card { margin-top: 16px; }
    .card-body { padding: 20px; }
    .card-header {
      padding: 12px 20px; border-bottom: 1px solid var(--cts-beige);
      font-weight: 600; font-size: 13px; display: flex; align-items: center; justify-content: space-between;
      color: var(--cts-text-mid); background: var(--cts-beige);
    }

    /* ── Forms ── */
    input, select, textarea {
      width: 100%; padding: 9px 12px; border: 1px solid var(--cts-beige-dark);
      border-radius: var(--radius-sm); font-size: 13px; color: var(--cts-text);
      background: var(--cts-white); transition: all 0.2s; font-family: inherit;
    }
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--cts-gold); box-shadow: 0 0 0 2px rgba(196,162,101,0.12); }
    textarea { resize: vertical; min-height: 80px; }
    label { display: block; font-size: 11px; font-weight: 600; color: var(--cts-text-mid); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.8px; }
    .form-group { margin-bottom: 14px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }

    /* ── Tags ── */
    .tag { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 3px; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; }
    .tag-proceso { background: var(--cts-warning-light); color: var(--cts-warning); }
    .tag-aprobado { background: var(--cts-success-light); color: var(--cts-success); }
    .tag-rechazado { background: var(--cts-danger-light); color: var(--cts-danger); }

    /* ── Table ── */
    .table-wrap { overflow-x: auto; border: 1px solid var(--cts-beige-dark); border-radius: var(--radius); }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th { text-align: left; padding: 10px 14px; font-size: 10px; font-weight: 600; color: var(--cts-text-light); text-transform: uppercase; letter-spacing: 0.8px; border-bottom: 1px solid var(--cts-beige-dark); background: var(--cts-beige); }
    td { padding: 10px 14px; border-bottom: 1px solid var(--cts-beige); color: var(--cts-text-mid); }
    tr:hover td { background: var(--cts-cream); }
    tr { cursor: pointer; }

    /* ── Search & Filters ── */
    .search-bar { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
    .search-bar input { max-width: 300px; }
    .filter-pills { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 12px; }
    .filter-pill {
      padding: 4px 14px; border-radius: 3px; font-size: 10px; font-weight: 600;
      border: 1px solid var(--cts-beige-dark); background: var(--cts-white); color: var(--cts-text-light);
      cursor: pointer; transition: all 0.2s; text-transform: uppercase; letter-spacing: 0.5px;
    }
    .filter-pill:hover { border-color: var(--cts-gold); color: var(--cts-gold); }
    .filter-pill.active { background: var(--cts-dark); color: var(--cts-gold); border-color: var(--cts-dark); }

    /* ── Modal ── */
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(44,24,16,0.4); z-index: 200;
      display: none; align-items: center; justify-content: center; padding: 20px;
      backdrop-filter: blur(2px);
    }
    .modal-overlay.open { display: flex; }
    .modal { background: var(--cts-white); border-radius: var(--radius); box-shadow: var(--shadow-lg); max-width: 750px; width: 100%; max-height: 85vh; overflow-y: auto; border: 1px solid var(--cts-beige-dark); }
    .modal-header {
      padding: 16px 24px; border-bottom: 1px solid var(--cts-beige);
      display: flex; align-items: center; justify-content: space-between;
      font-size: 16px; font-weight: 600; position: sticky; top: 0;
      background: var(--cts-beige); z-index: 1; font-family: 'Playfair Display', serif;
      color: var(--cts-dark);
    }
    .modal-header .close { background: none; border: none; font-size: 20px; cursor: pointer; color: var(--cts-text-light); padding: 0 4px; }
    .modal-body { padding: 24px; }

    /* ── Steps ── */
    .steps { display: flex; gap: 0; margin-bottom: 28px; border: 1px solid var(--cts-beige-dark); border-radius: var(--radius); overflow: hidden; }
    .step { flex: 1; text-align: center; padding: 10px; font-size: 11px; font-weight: 600; color: var(--cts-text-light); background: var(--cts-beige); letter-spacing: 0.3px; }
    .step + .step { border-left: 1px solid var(--cts-beige-dark); }
    .step.active { color: var(--cts-gold); background: var(--cts-dark); }
    .step.done { color: white; background: var(--cts-success); }
    .step .step-num { display: inline-flex; width: 20px; height: 20px; border-radius: 50%; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; background: var(--cts-beige-dark); color: var(--cts-text-light); margin-right: 5px; }
    .step.active .step-num { background: rgba(196,162,101,0.25); color: var(--cts-gold); }
    .step.done .step-num { background: rgba(255,255,255,0.2); color: white; }

    /* ── Client Detail ── */
    .client-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .client-detail-grid .field-label { font-size: 10px; color: var(--cts-text-light); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .client-detail-grid .field-value { font-size: 14px; color: var(--cts-text); margin-top: 1px; }
    .progress-bar { height: 5px; background: var(--cts-beige-dark); border-radius: 2px; overflow: hidden; margin: 10px 0; }
    .progress-bar-fill { height: 100%; background: var(--cts-gold); border-radius: 2px; transition: width 0.3s; }

    /* ── Checklist ── */
    .checklist-item { display: flex; align-items: flex-start; gap: 12px; padding: 10px 14px; border: 1px solid var(--cts-beige-dark); border-radius: var(--radius-sm); margin-bottom: 6px; background: var(--cts-white); cursor: pointer; transition: all 0.2s; }
    .checklist-item:hover { border-color: var(--cts-gold); }
    .checklist-item.done { background: var(--cts-success-light); border-color: var(--cts-success); }
    .checklist-item .cl-text { flex: 1; }
    .checklist-item .cl-title { font-weight: 600; font-size: 13px; }
    .checklist-item .cl-desc { font-size: 11px; color: var(--cts-text-light); margin-top: 2px; }

    /* ── Templates ── */
    .template-card {
      background: var(--cts-white); border: 1px solid var(--cts-beige-dark);
      padding: 16px; margin-bottom: 10px; transition: all 0.2s;
      border-left: 3px solid var(--cts-gold);
    }
    .template-card:hover { box-shadow: var(--shadow-md); border-left-color: var(--cts-dark); }
    .template-card .temp-title { font-weight: 600; font-size: 14px; margin-bottom: 6px; display: flex; align-items: center; gap: 8px; color: var(--cts-dark); }
    .template-card .temp-text { font-size: 13px; color: var(--cts-text-mid); line-height: 1.5; white-space: pre-wrap; }
    .template-card .temp-actions { float: right; display: flex; gap: 4px; }

    /* ── Toast ── */
    .toast {
      position: fixed; bottom: 24px; right: 24px;
      background: var(--cts-dark); color: var(--cts-gold); padding: 12px 20px;
      border-radius: var(--radius-sm); font-size: 13px; font-weight: 500;
      box-shadow: var(--shadow-lg); z-index: 300;
      transform: translateY(100px); opacity: 0; transition: all 0.3s;
      border-left: 3px solid var(--cts-gold);
    }
    .toast.show { transform: translateY(0); opacity: 1; }

    /* ── Misc ── */
    .empty-state { text-align: center; padding: 60px 20px; color: var(--cts-text-light); }
    .empty-state i { font-size: 44px; margin-bottom: 12px; opacity: 0.4; }
    .empty-state p { font-size: 14px; }
    .inline-flex { display: flex; align-items: center; gap: 8px; }
    .flex-between { display: flex; align-items: center; justify-content: space-between; }
    .text-center { text-align: center; }
    .hidden { display: none; }
    .mb-2 { margin-bottom: 8px; }
    .mb-4 { margin-bottom: 16px; }
    .mt-2 { margin-top: 8px; }
    .mt-4 { margin-top: 16px; }
    .w-full { width: 100%; }
    .skeleton {
      background: linear-gradient(90deg, var(--cts-beige) 25%, var(--cts-cream) 50%, var(--cts-beige) 75%);
      background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: 4px;
    }
    @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

    /* ── WhatsApp ── */
    .whatsapp-selector { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }
    .whatsapp-option {
      padding: 10px; border: 1px solid var(--cts-beige-dark); border-radius: var(--radius-sm);
      cursor: pointer; font-size: 13px; transition: all 0.2s;
    }
    .whatsapp-option:hover { border-color: #25D366; background: #f0fdf4; }
    .whatsapp-option.selected { border-color: #25D366; background: #f0fdf4; }

    /* ── Decorative ── */
    .diamond-separator {
      display: flex; align-items: center; gap: 12px; margin: 20px 0;
      color: var(--cts-gold); font-size: 8px;
    }
    .diamond-separator::before, .diamond-separator::after {
      content: ''; flex: 1; height: 1px; background: var(--cts-beige-dark);
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      .sidebar { width: 60px; }
      .sidebar-brand .brand-text, .sidebar-nav a span, .sidebar-footer { display: none; }
      .sidebar-brand { justify-content: center; padding: 16px 0; }
      .sidebar-brand .brand-icon { font-size: 12px; width: 30px; height: 30px; }
      .sidebar-nav a { justify-content: center; padding: 12px; }
      .main { margin-left: 60px; padding: 16px; }
      .form-row, .form-row-3, .client-detail-grid, .whatsapp-selector { grid-template-columns: 1fr; }
      .stats-grid { grid-template-columns: 1fr 1fr; }
    }
  </style>
</head>
<body>

<div class="sidebar">
  <div class="sidebar-brand">
    <div class="brand-icon">CTS</div>
    <div class="brand-text">
      <div class="brand-name">CTS</div>
      <div class="brand-sub">Visa Services</div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <a class="active" data-page="dashboard"><i class="fas fa-chart-pie"></i><span>Dashboard</span></a>
    <a data-page="clientes"><i class="fas fa-users"></i><span>Clientes</span></a>
    <a data-page="nuevo"><i class="fas fa-user-plus"></i><span>Nuevo Cliente</span></a>
    <a data-page="checklist"><i class="fas fa-list-check"></i><span>Checklist DS-160</span></a>
    <a data-page="mensajes"><i class="fas fa-comment-dots"></i><span>Mensajes Rápidos</span></a>
    <a data-page="exportar"><i class="fas fa-file-export"></i><span>Exportar</span></a>
    <a href="/logout" style="margin-top:auto"><i class="fas fa-sign-out-alt"></i><span>Cerrar Sesión</span></a>
  </nav>
  <div class="sidebar-footer"><%= user.nombre %> &middot; CTS</div>
</div>

<div class="main">

  <!-- DASHBOARD -->
  <div id="page-dashboard" class="page active">
    <div class="page-header">
      <h1>Dashboard</h1>
      <p>Resumen en tiempo real de tu gestión de visas</p>
    </div>
    <div class="stats-grid" id="statsGrid">
      <div class="stat-card"><div class="stat-icon"><i class="fas fa-users"></i></div><div class="stat-label">Total Clientes</div><div class="stat-value" id="statTotal">-</div></div>
      <div class="stat-card"><div class="stat-icon"><i class="fas fa-spinner"></i></div><div class="stat-label">En Proceso</div><div class="stat-value" style="color:var(--cts-warning)" id="statProceso">-</div></div>
      <div class="stat-card"><div class="stat-icon"><i class="fas fa-check-circle"></i></div><div class="stat-label">Aprobados</div><div class="stat-value" style="color:var(--cts-success)" id="statAprobado">-</div></div>
      <div class="stat-card"><div class="stat-icon"><i class="fas fa-times-circle"></i></div><div class="stat-label">Rechazados</div><div class="stat-value" style="color:var(--cts-danger)" id="statRechazado">-</div></div>
    </div>
    <div class="card">
      <div class="card-header">Clientes por Mes</div>
      <div class="card-body"><canvas id="chartMensual" height="200"></canvas></div>
    </div>
    <div class="card">
      <div class="card-header">Últimos Clientes Registrados</div>
      <div class="card-body" id="recentClients"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Cargando...</p></div></div>
    </div>
  </div>

  <!-- CLIENTES -->
  <div id="page-clientes" class="page">
    <div class="page-header flex-between">
      <div><h1>Clientes</h1><p>Gestiona todos tus clientes y sus expedientes</p></div>
      <button class="btn btn-primary" onclick="navigate('nuevo')"><i class="fas fa-plus"></i> Nuevo Cliente</button>
    </div>
    <div class="card">
      <div class="card-body">
        <div class="filter-pills">
          <span class="filter-pill active" data-filter="all" onclick="setFilter(this)">Todos</span>
          <span class="filter-pill" data-filter="proceso" onclick="setFilter(this)">En Proceso</span>
          <span class="filter-pill" data-filter="aprobado" onclick="setFilter(this)">Aprobados</span>
          <span class="filter-pill" data-filter="rechazado" onclick="setFilter(this)">Rechazados</span>
        </div>
        <div class="search-bar">
          <input type="text" id="searchInput" placeholder="Buscar por nombre, pasaporte o email..." oninput="renderClientes()">
          <button class="btn btn-outline btn-sm" onclick="document.getElementById('searchInput').value='';renderClientes()"><i class="fas fa-times"></i></button>
          <span style="font-size:12px;color:var(--cts-text-light);align-self:center" id="clientCount"></span>
        </div>
        <div class="table-wrap" id="clientesTableWrap"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Cargando...</p></div></div>
      </div>
    </div>
  </div>

  <!-- NUEVO CLIENTE -->
  <div id="page-nuevo" class="page">
    <div class="page-header"><h1>Nuevo Cliente</h1><p>Captura todos los datos necesarios para el DS-160</p></div>
    <div class="card">
      <div class="card-body">
        <div class="steps" id="formSteps">
          <div class="step active" data-step="1"><span class="step-num">1</span>Datos Personales</div>
          <div class="step" data-step="2"><span class="step-num">2</span>Contacto & Viaje</div>
          <div class="step" data-step="3"><span class="step-num">3</span>Situación Migratoria</div>
        </div>
        <form id="clientForm" onsubmit="return false;">
          <div class="form-step fade-in" data-step="1">
            <div class="form-row">
              <div class="form-group"><label>Nombre *</label><input type="text" id="fNombre" required></div>
              <div class="form-group"><label>Apellido *</label><input type="text" id="fApellido" required></div>
            </div>
            <div class="form-row-3">
              <div class="form-group"><label>Fecha de Nacimiento *</label><input type="date" id="fFechaNac" required></div>
              <div class="form-group"><label>Lugar de Nacimiento</label><input type="text" id="fLugarNac"></div>
              <div class="form-group"><label>Nacionalidad</label><input type="text" id="fNacionalidad" value="Mexicana"></div>
            </div>
            <div class="form-row-3">
              <div class="form-group"><label>Género</label><select id="fGenero"><option value="">Seleccionar...</option><option>Masculino</option><option>Femenino</option></select></div>
              <div class="form-group"><label>Estado Civil</label><select id="fEstadoCivil"><option value="">Seleccionar...</option><option>Soltero/a</option><option>Casado/a</option><option>Divorciado/a</option><option>Viudo/a</option></select></div>
              <div class="form-group"><label>Ocupación</label><input type="text" id="fOcupacion"></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Número de Pasaporte *</label><input type="text" id="fPasaporte" required></div>
              <div class="form-group"><label>País de Emisión</label><input type="text" id="fPaisEmision" value="México"></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Fecha de Expedición</label><input type="date" id="fFechaExp"></div>
              <div class="form-group"><label>Fecha de Vencimiento *</label><input type="date" id="fFechaVen" required></div>
            </div>
            <button type="button" class="btn btn-primary" onclick="nextStep()">Siguiente <i class="fas fa-arrow-right"></i></button>
          </div>
          <div class="form-step hidden fade-in" data-step="2">
            <h3 style="font-size:15px;margin-bottom:12px;color:var(--cts-text-mid)">Información de Contacto</h3>
            <div class="form-row">
              <div class="form-group"><label>Email *</label><input type="email" id="fEmail" required></div>
              <div class="form-group"><label>Teléfono *</label><input type="tel" id="fTelefono" required></div>
            </div>
            <div class="form-group"><label>Dirección</label><input type="text" id="fDireccion"></div>
            <div class="form-row-3">
              <div class="form-group"><label>Ciudad</label><input type="text" id="fCiudad"></div>
              <div class="form-group"><label>Estado</label><input type="text" id="fEstado"></div>
              <div class="form-group"><label>Código Postal</label><input type="text" id="fCodigoPostal"></div>
            </div>
            <h3 style="font-size:15px;margin:16px 0 12px;color:var(--cts-text-mid)">Información del Viaje</h3>
            <div class="form-row-3">
              <div class="form-group"><label>Propósito del Viaje</label><select id="fProposito"><option value="">Seleccionar...</option><option>Turismo</option><option>Negocios</option><option>Estudios</option><option>Trabajo</option><option>Visita familiar</option><option>Médico</option></select></div>
              <div class="form-group"><label>Fecha Estimada</label><input type="date" id="fFechaViaje"></div>
              <div class="form-group"><label>Duración (días)</label><input type="number" id="fDuracion"></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Alojamiento en EE.UU.</label><input type="text" id="fAlojamiento" placeholder="Hotel / Dirección"></div>
              <div class="form-group"><label>Gastos Pagados Por</label><select id="fGastos"><option value="">Seleccionar...</option><option>Si mismo</option><option>Familiar</option><option>Empresa</option><option>Otro</option></select></div>
            </div>
            <div style="display:flex;gap:8px;margin-top:8px">
              <button type="button" class="btn btn-outline" onclick="prevStep()"><i class="fas fa-arrow-left"></i> Atrás</button>
              <button type="button" class="btn btn-primary" onclick="nextStep()">Siguiente <i class="fas fa-arrow-right"></i></button>
            </div>
          </div>
          <div class="form-step hidden fade-in" data-step="3">
            <h3 style="font-size:15px;margin-bottom:12px;color:var(--cts-text-mid)">Situación Migratoria</h3>
            <div class="form-group"><label>¿Ha viajado antes a EE.UU.?</label><select id="fViajePrev"><option value="">Seleccionar...</option><option>Si</option><option>No</option></select></div>
            <div class="form-group"><label>¿Ha tenido visa americana anteriormente?</label><select id="fVisaPrevia"><option value="">Seleccionar...</option><option>Si</option><option>No</option></select></div>
            <div class="form-group"><label>¿Le han negado alguna vez una visa?</label><select id="fNegacion"><option value="">Seleccionar...</option><option>Si</option><option>No</option></select></div>
            <div class="form-group"><label>¿Tiene familiares en EE.UU.?</label><select id="fFamiliares"><option value="">Seleccionar...</option><option>Si</option><option>No</option></select></div>
            <div class="form-group"><label>Notas adicionales</label><textarea id="fNotas" placeholder="Información relevante para el caso..."></textarea></div>
            <div style="display:flex;gap:8px;margin-top:8px">
              <button type="button" class="btn btn-outline" onclick="prevStep()"><i class="fas fa-arrow-left"></i> Atrás</button>
              <button type="button" class="btn btn-success" onclick="guardarCliente()"><i class="fas fa-save"></i> Guardar Cliente</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- CHECKLIST DS-160 -->
  <div id="page-checklist" class="page">
    <div class="page-header"><h1>Checklist DS-160</h1><p>Las 12 secciones del formulario DS-160 con barra de progreso</p></div>
    <div class="card">
      <div class="card-body">
        <div class="flex-between mb-2">
          <span style="font-weight:600;font-size:15px">Progreso General</span>
          <span style="font-weight:600;font-size:15px" id="checklistPercent">0%</span>
        </div>
        <div class="progress-bar"><div class="progress-bar-fill" id="checklistProgress" style="width:0%"></div></div>
        <div style="margin-top:16px" id="checklistItems"></div>
      </div>
    </div>
  </div>

  <!-- MENSAJES RAPIDOS -->
  <div id="page-mensajes" class="page">
    <div class="page-header flex-between">
      <div><h1>Mensajes Rápidos</h1><p>Plantillas editables para WhatsApp. Haz clic en cualquier campo para editarlo.</p></div>
      <button class="btn btn-primary" onclick="nuevaPlantilla()"><i class="fas fa-plus"></i> Nueva Plantilla</button>
    </div>
    <div class="card">
      <div class="card-body" id="templatesContainer"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Cargando...</p></div></div>
    </div>
  </div>

  <!-- EXPORTAR -->
  <div id="page-exportar" class="page">
    <div class="page-header"><h1>Exportar</h1><p>Descarga todos tus clientes en Excel o CSV con un clic</p></div>
    <div class="stats-grid" style="grid-template-columns:1fr 1fr">
      <div class="card">
        <div class="card-body text-center" style="padding:40px">
          <i class="fas fa-file-excel" style="font-size:48px;color:var(--cts-success);margin-bottom:12px"></i>
          <h3 style="margin-bottom:8px">Exportar a Excel</h3>
          <p style="font-size:13px;color:var(--cts-text-mid);margin-bottom:16px">Descarga todos los datos en formato .xlsx</p>
          <button class="btn btn-success" onclick="exportarExcel()"><i class="fas fa-download"></i> Descargar Excel</button>
        </div>
      </div>
      <div class="card">
        <div class="card-body text-center" style="padding:40px">
          <i class="fas fa-file-csv" style="font-size:48px;color:var(--cts-dark);margin-bottom:12px"></i>
          <h3 style="margin-bottom:8px">Exportar a CSV</h3>
          <p style="font-size:13px;color:var(--cts-text-mid);margin-bottom:16px">Descarga todos los datos en formato .csv</p>
          <button class="btn btn-primary" onclick="exportarCSV()"><i class="fas fa-download"></i> Descargar CSV</button>
        </div>
      </div>
    </div>
    <div class="card mt-4">
      <div class="card-header">Vista Previa de Datos a Exportar</div>
      <div class="card-body">
        <p style="font-size:14px;color:var(--cts-text-mid);margin-bottom:12px"><span id="exportCount">0</span> clientes listos para exportar</p>
        <div class="table-wrap" id="exportPreview"><div class="empty-state"><i class="fas fa-table"></i><p>No hay datos</p></div></div>
      </div>
    </div>
  </div>

</div>

<!-- MODAL CLIENTE -->
