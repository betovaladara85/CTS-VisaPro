<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CTS - Iniciar Sesión</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap');
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: #FAF8F5; min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 20px;
    }
    .login-card {
      background: #FFFFFF; border-radius: 6px; padding: 48px 40px 36px;
      width: 100%; max-width: 400px;
      box-shadow: 0 8px 24px rgba(44,24,16,0.06);
      border: 1px solid #E8E0D8;
      position: relative;
    }
    .login-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: #C4A265; border-radius: 6px 6px 0 0;
    }
    .login-brand { text-align: center; margin-bottom: 36px; }
    .login-brand .brand-logo {
      width: 56px; height: 56px; margin: 0 auto 16px;
      background: #2C1810; border-radius: 4px;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700;
      color: #C4A265; letter-spacing: 1px;
    }
    .login-brand h1 {
      font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 600;
      color: #2C1810; letter-spacing: 0.5px;
    }
    .login-brand .diamond {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      margin: 12px 0 8px; color: #C4A265; font-size: 8px;
    }
    .login-brand .diamond::before, .login-brand .diamond::after {
      content: ''; width: 40px; height: 1px; background: #E8E0D8;
    }
    .login-brand p {
      font-size: 11px; color: #9A8B7E; letter-spacing: 2px; text-transform: uppercase;
    }
    .form-group { margin-bottom: 18px; }
    label { display: block; font-size: 10px; font-weight: 600; color: #6B5B4F; margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.8px; }
    input {
      width: 100%; padding: 10px 14px; border: 1px solid #E8E0D8;
      border-radius: 4px; font-size: 14px; transition: all 0.2s;
      font-family: inherit; color: #2C1810; background: #FAF8F5;
    }
    input:focus { outline: none; border-color: #C4A265; background: white; box-shadow: 0 0 0 2px rgba(196,162,101,0.12); }
    .btn {
      width: 100%; padding: 11px; border: none; border-radius: 4px;
      font-size: 13px; font-weight: 600; cursor: pointer; letter-spacing: 0.5px;
      background: #2C1810; color: #C4A265; transition: all 0.2s;
      font-family: 'Inter', sans-serif;
    }
    .btn:hover { background: #3D2A1E; }
    .btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .error {
      background: #FDEEE8; color: #8B2500; padding: 10px 14px;
      border-radius: 4px; font-size: 13px; margin-bottom: 16px;
      display: none; border: 1px solid #F5D5C8;
    }
    .error.show { display: block; }
    .footer {
      text-align: center; margin-top: 28px; padding-top: 20px;
      border-top: 1px solid #E8E0D8;
      font-size: 9px; color: #9A8B7E; letter-spacing: 2px; text-transform: uppercase;
    }
    .btn-google {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      width: 100%; padding: 10px; border: 1px solid #E8E0D8; border-radius: 4px;
      background: white; color: #2C1810; font-size: 13px; font-weight: 500;
      cursor: pointer; transition: all 0.2s; text-decoration: none;
      font-family: 'Inter', sans-serif;
    }
    .btn-google:hover { background: #FAF8F5; border-color: #C4A265; }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="login-brand">
      <div class="brand-logo">CTS</div>
      <h1>Certified Translation & Visa Service</h1>
      <div class="diamond"><span>&#9670;</span></div>
      <p>English-Spanish</p>
    </div>
    <div class="error" id="errorMsg"></div>
    <div class="error" id="jsError"></div>
    <form id="loginForm">
      <div class="form-group">
        <label>Email</label>
        <input type="email" id="email" placeholder="tu@email.com" required autofocus>
      </div>
      <div class="form-group">
        <label>Contraseña</label>
        <input type="password" id="password" placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn" id="loginBtn">Iniciar Sesión</button>
    </form>
    <div style="margin: 20px 0; display: flex; align-items: center; gap: 12px;">
      <div style="flex: 1; height: 1px; background: #E8E0D8;"></div>
      <span style="font-size: 11px; color: #9A8B7E; text-transform: uppercase; letter-spacing: 1px;">o</span>
      <div style="flex: 1; height: 1px; background: #E8E0D8;"></div>
    </div>
    <a href="/auth/google" class="btn-google" id="googleBtn">
      <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
      Iniciar con Gmail
    </a>
    <div class="footer">Certified Translations &middot; Visa Services &middot; Immigration Assistance</div>
  </div>
  <script>
    const params = new URLSearchParams(window.location.search);
    const errorParam = params.get('error');
    if (errorParam) {
      const errMsg = document.getElementById('errorMsg');
      const errors = {
        'no_account': 'No hay cuenta asociada a este correo. Solicita acceso al administrador.',
        'google_not_configured': 'Login con Google no está configurado. Usa email y contraseña.',
        'access_denied': 'Acceso denegado. Inténtalo de nuevo.'
      };
      errMsg.textContent = errors[errorParam] || 'Error al iniciar sesión con Google.';
      errMsg.classList.add('show');
    }

    document.getElementById('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('loginBtn');
      const err = document.getElementById('jsError');
      btn.disabled = true; btn.textContent = 'Entrando...';
      err.classList.remove('show');
      try {
        const res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: document.getElementById('email').value,
            password: document.getElementById('password').value
          })
        });
        const data = await res.json();
        if (!res.ok) {
          err.textContent = data.error || 'Error al iniciar sesión';
          err.classList.add('show');
          btn.disabled = false; btn.textContent = 'Iniciar Sesión';
          return;
        }
        window.location.href = data.role === 'admin' ? '/admin' : '/cliente';
      } catch(e) {
        err.textContent = 'Error de conexión';
        err.classList.add('show');
        btn.disabled = false; btn.textContent = 'Iniciar Sesión';
      }
    });
  </script>
</body>
</html>